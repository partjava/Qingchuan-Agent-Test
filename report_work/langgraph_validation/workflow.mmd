---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	decide(decide)
	tools(tools)
	verify(verify)
	finish(finish)
	__end__([<p>__end__</p>]):::last
	__start__ --> decide;
	decide -.-> finish;
	decide -.-> tools;
	decide -.-> verify;
	tools -.-> decide;
	tools -.-> finish;
	verify -.-> decide;
	verify -.-> finish;
	finish --> __end__;
	decide -.-> decide;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
